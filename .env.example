# Paddle Billing. Required. Use live or sandbox. The app does not choose one for you.
PADDLE_ENV=

# Client-side token. Use a live_ token when PADDLE_ENV is live, and a test_ token when it is sandbox.
PADDLE_CLIENT_TOKEN=

# The office billing page still uses this single price.
PADDLE_PRICE_ID=

# Pricing page. One Paddle price id for each tier and billing interval.
PADDLE_PRICE_STARTER_MONTH=
PADDLE_PRICE_STARTER_YEAR=
PADDLE_PRICE_PRO_MONTH=
PADDLE_PRICE_PRO_YEAR=
PADDLE_PRICE_ADVANCED_MONTH=
PADDLE_PRICE_ADVANCED_YEAR=

# Server-only Paddle API key. Used for the customer portal. Never expose this to the browser.
PADDLE_API_KEY=

# Server-only. Notification signing secret from Events > Notifications. Not the API key.
PADDLE_WEBHOOK_SECRET=
